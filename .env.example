# ============================================================
# YT AI Agent – Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string-here

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yt_ai_agent?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Google OAuth + YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
YOUTUBE_API_KEY=                      # optional for public data; OAuth preferred for user channels

# Google Gemini
GEMINI_API_KEY=

# Whisper / transcription (OpenAI-compatible or self-hosted)
WHISPER_API_KEY=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# JWT
JWT_SECRET=another-long-random-string
JWT_EXPIRES_IN=7d

# Storage (local or S3-compatible)
STORAGE_PATH=./storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# Rate limiting / security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature flags
ENABLE_VIDEO_GENERATION=false         # set true when GPU workers ready
ENABLE_4K_EXPORT=false
